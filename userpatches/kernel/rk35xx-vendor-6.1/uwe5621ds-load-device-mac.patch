From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Torder Tablet Build <build@torder.local>
Date: Tue, 11 Aug 2026 00:00:00 +0800
Subject: [PATCH] wifi: uwe5622: load the provisioned device MAC

The UWE5621DS driver registers wlan0 before userspace can assign a valid
address. Load the per-device address provisioned in /lib/firmware before
creating the wireless interface, matching the behavior of the working image.

---
 drivers/net/wireless/uwe5622/unisocwifi/main.c | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/drivers/net/wireless/uwe5622/unisocwifi/main.c b/drivers/net/wireless/uwe5622/unisocwifi/main.c
index 46b9039519cd..59ad06f358f1 100644
--- a/drivers/net/wireless/uwe5622/unisocwifi/main.c
+++ b/drivers/net/wireless/uwe5622/unisocwifi/main.c
@@ -18,3 +18,5 @@
+#include <linux/firmware.h>
+
 #include "sprdwl.h"
 #include "npi.h"
 #include "cfg80211.h"
@@ -1557,6 +1557,46 @@ static void sprdwl_init_debugfs(struct sprdwl_priv *priv)
 	sprdwl_intf_debugfs(priv, priv->debugfs);
 }
 
+static void sprdwl_init_mac_addr(struct device *dev, struct sprdwl_priv *priv)
+{
+	const char *fw_path = "unisoc_wifi_mac.txt";
+	const struct firmware *fw;
+	char mac_text[18];
+	u8 *mac_addr = priv->mac_addr;
+	int ret;
+
+	eth_zero_addr(mac_addr);
+	ret = request_firmware(&fw, fw_path, dev);
+	if (ret) {
+		pr_err("sprdwl:Failed to load mac address file: %s\n",
+		       fw_path);
+		goto random_mac;
+	}
+
+	if (fw->size < 17) {
+		pr_err("sprdwl:MAC address string too short or missing !!!\n");
+		goto release_and_randomize;
+	}
+
+	memcpy(mac_text, fw->data, 17);
+	mac_text[17] = '\0';
+	if (!mac_pton(mac_text, mac_addr) ||
+	    !is_valid_ether_addr(mac_addr)) {
+		pr_err("sprdwl:Failed to parse MAC address from string !!!\n");
+		goto release_and_randomize;
+	}
+
+	pr_info("sprdwl:FW-set MAC address: %pM\n", mac_addr);
+	release_firmware(fw);
+	return;
+
+release_and_randomize:
+	release_firmware(fw);
+random_mac:
+	pr_err("sprdwl:Generating random MAC address !!!\n");
+	eth_random_addr(mac_addr);
+}
+
 int sprdwl_core_init(struct device *dev, struct sprdwl_priv *priv)
 {
 	struct wiphy *wiphy = priv->wiphy;
@@ -1580,6 +1620,7 @@ int sprdwl_core_init(struct device *dev, struct sprdwl_priv *priv)
 	}
 	sprdwl_init_debugfs(priv);
 
+	sprdwl_init_mac_addr(dev, priv);
 	rtnl_lock();
 	wdev = sprdwl_add_iface(priv, "wlan%d", NL80211_IFTYPE_STATION, NULL);
 	rtnl_unlock();
-- 
